    "@ai-sdk/mistral": "4.0.54",
    "@ai-sdk/moonshotai": "3.0.60",
    "@ai-sdk/openai": "4.0.81",
    "@ai-sdk/openai-compatible": "3.0.59",
    "@ai-sdk/react": "4.0.125",
    "@ai-sdk/togetherai": "3.0.60",
    "@ai-sdk/xai": "5.0.12",
    "@dylankenneally/react-native-ssh-sftp": "^1.11.0",
