  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-class-static-block": "7.28.6",
    "@gluestack-ui/nativewind-utils": "^1.0.28",
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "^29.5.14",
    "@types/node": "22.20.1",
    "@types/react": "~19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vue": "3.5.43"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "lucide-react-native",
          "@expo/html-elements",
          "@gluestack-ui/core",
          "@gluestack-ui/utils",
          "@legendapp/motion",
          "react-native-drag-sort",
          "tailwindcss",
          "use-debounce"
        ]
      }
    },
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  }
}
