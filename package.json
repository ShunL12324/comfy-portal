{
  "name": "comfy-portal",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "ios": "REACT_NATIVE_PACKAGER_HOSTNAME=$(ipconfig getifaddr $(route get default | awk '/interface:/{print $2}') || ipconfig getifaddr en0) expo run:ios --device \"iPhone\"",
    "android": "expo run:android",
    "prebuild": "expo prebuild --clean --no-install",
    "pod": "cd ios && pod install && cd ..",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit -p .",
    "lint:src": "eslint app features hooks services store utils shims components/self-ui components/common components/layout",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "reset-project": "node ./scripts/reset-project.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "jest": {
    "preset": "jest-expo"
  },
