    "@ai-sdk/cerebras": "3.0.59",
    "@ai-sdk/cohere": "4.0.52",
    "@ai-sdk/deepinfra": "3.0.59",
    "@ai-sdk/deepseek": "3.0.56",
    "@ai-sdk/fireworks": "3.0.62",
    "@ai-sdk/google": "4.0.85",
