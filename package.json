{
  "name": "comfy-portal",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "ios": "REACT_NATIVE_PACKAGER_HOSTNAME=$(ipconfig getifaddr $(route get default | awk '/interface:/{print $2}') || ipconfig getifaddr en0) expo run:ios --device \"iPhone\"",
    "android": "expo run:android",
    "prebuild": "expo prebuild --no-install",
    "pod": "cd ios && pod install && cd ..",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit -p .",
    "lint:colors": "node scripts/check-color-tokens.cjs",
    "lint:icons": "node scripts/check-icon-tokens.cjs",
    "lint:src": "eslint src/app src/features src/hooks src/services src/store src/utils src/shims src/components/self-ui src/components/common src/components/layout",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "moduleNameMapper": {
      "^@react-native-async-storage/async-storage$": "@react-native-async-storage/async-storage/jest/async-storage-mock"
    }
  },
  "dependencies": {
    "@ai-sdk/alibaba": "2.0.58",
